# XIOM PULSE -- build artifacts and local state
# Compiler output (a.exe/a.exe.ll land next to the compiled source)
a.exe
a.exe.ll
*.exe.ll
*.o
*.obj
*.pdb
*.ilk
*.dll
*.lib
*.exp
*.ll
*.bc
a.out

# Local build/release output
/out/
/bin/
/obj/
/dist/

# Probe + soak logs (keep summaries, not raw runs)
*.log
/probe-logs/
/soak/
# XIOM PULSE runtime data (JSONL stores)
/pulse-events.jsonl
/pulse-store-test.jsonl
/pulse-audit.log

# multipart uploads (POST /api/uploads, PULSE_UPLOAD_DIR)
/uploads/
/pulse-store-test.jsonl-uploads*/
/docs/repro/io-list-dir-dangling/.tmp-lsd/

# interop probe state (tests/interop/<lane>/, sibling source trees)
/tests/interop/*/.tmp/

# site-mode test fixtures (tests/test_app.xi)
/pulse-test-site/

# xiom.kv probe segments (tests/probes/probe_pkg_kv.xi, best-effort cleanup)
/kvprobe-*.kv

# audit rotation probe files (tests/probes/probe_audit_rotate.xi)
/pulse-audit-rotate-test.log*

# adopt-smoke probe trace (tests/probes/probe_adopt_smoke.xi)
/pulse-adopt-steps.txt

# editor artifacts
/.VSCodeCounter/

# release artifacts (scripts/release.*)
/dist/

# backup snapshots (scripts/backup.*)
/backups/

# Kilo / Agent Manager workspace state (never commit)
.kilo/
*.code-workspace
.vscode/

# XIOM package manager local state (xiom.lock stays committed)
.xiom_ai_cache/
.xiom-cache/

# Secrets / env
.env
.env.*

# OS noise
Thumbs.db
Desktop.ini
.DS_Store
