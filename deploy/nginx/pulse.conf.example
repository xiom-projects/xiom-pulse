# XIOM PULSE -- nginx site example (TLS termination in front of PULSE).
# Copyright (c) 2026 Eleftherios Notas and The XIOM Authors
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Production shape: nginx terminates TLS (Certbot certs) and proxies to
# PULSE on loopback. PULSE has no recv timeouts yet, so keep proxy read
# timeouts tight. Metrics are restricted to the monitoring network.
#
# Install: copy to /etc/nginx/sites-available/pulse.conf, adjust the
# server_name + cert paths, `nginx -t`, then `systemctl reload nginx`.

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name staging.pulse.xiom-lang.org;

    ssl_certificate     /etc/letsencrypt/live/staging.pulse.xiom-lang.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.pulse.xiom-lang.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection close;   # PULSE is Connection: close today
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_read_timeout 10s;              # app-level timeouts pending (stdlib)
        proxy_send_timeout 10s;
    }

    location /metrics {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }
}
