# Replace example.com with your domain, or use :8080 for a local test.
# PULSE speaks plaintext HTTP/1.1; Caddy owns TLS and compression.
example.com {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy 127.0.0.1:8080 {
        health_uri /health
        health_interval 10s
        health_timeout 2s
    }
}
